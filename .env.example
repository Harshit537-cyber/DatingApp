# ============================================================
# Bummps Dating App - Environment Configuration
# ============================================================

# Server Configuration
PORT=5000
NODE_ENV=development
APP_BASE_URL=http://localhost:5000

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/datingapp

# Authentication & Security
JWT_SECRET=your_jwt_secret_here_minimum_32_chars
OTP_HASH_SECRET=your_otp_secret_key_here

# Spotify Developer API & OAuth 2.0 PKCE Integration
# Obtain from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=https://api.bummps.com/api/spotify/callback

# Token Encryption at Rest (AES-256-GCM)
# 64-character hexadecimal string representing a 256-bit key.
# Generate in terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SPOTIFY_TOKEN_ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Stripe Payments & Connect
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
PLATFORM_COMMISSION_RATE=0.1
HOST_APPLICATION_FEE_CENTS=1000

# Firebase Admin SDK (Apple / Google Auth)
FIREBASE_PROJECT_ID=bummps-2b7de
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@...
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_FROM=noreply@bummps.com
