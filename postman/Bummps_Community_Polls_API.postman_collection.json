{
  "info": {
    "_postman_id": "c1f7b889-b001-4993-a4e9-bummps-community-polls",
    "name": "Bummps_Community_Polls_API",
    "description": "Production-grade Community Polls, Voting & The Buzz Discussion Integration API collection for Bummps Dating App.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "YOUR_USER_BEARER_TOKEN",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "YOUR_ADMIN_BEARER_TOKEN",
      "type": "string"
    },
    {
      "key": "pollId",
      "value": "",
      "type": "string"
    },
    {
      "key": "discussionId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Poll Creation",
      "item": [
        {
          "name": "POST Create Community Poll (2 Options)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Returns poll and auto-created discussion', function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.poll).to.be.an('object');",
                  "    pm.expect(jsonData.data.discussion).to.be.an('object');",
                  "    pm.expect(jsonData.data.discussion.isPoll).to.be.true;",
                  "});",
                  "if (jsonData.data && jsonData.data.poll && jsonData.data.poll._id) {",
                  "    pm.collectionVariables.set('pollId', jsonData.data.poll._id);",
                  "}",
                  "if (jsonData.data && jsonData.data.discussion && jsonData.data.discussion._id) {",
                  "    pm.collectionVariables.set('discussionId', jsonData.data.discussion._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"First Date Vibe: Speakeasy Cocktails or Candlelit Rooftop?\",\n  \"category\": \"DATING VIBE\",\n  \"options\": [\n    \"🍸 Speakeasy Cocktails\",\n    \"🕯️ Candlelit Rooftop\"\n  ],\n  \"durationDays\": 7\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/circle/polls",
              "host": ["{{baseUrl}}"],
              "path": ["api", "circle", "polls"]
            }
          }
        },
        {
          "name": "POST Create Community Poll (4 Options)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Poll has 4 options', function () {",
                  "    pm.expect(jsonData.data.poll.options.length).to.eql(4);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
