            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Ideal Sunday Morning with Your Partner?\",\n  \"category\": \"WEEKEND RHYTHM\",\n  \"options\": [\n    \"☕ Artisanal Coffee & Vinyl\",\n    \"🍳 Cook French Toast Together\",\n    \"🏃 Sunrise Trail Run\",\n    \"🛌 Sleep in & Order Brunch\"\n  ],\n  \"durationDays\": 14\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/circle/polls",
              "host": ["{{baseUrl}}"],
              "path": ["api", "circle", "polls"]
            }
          }
