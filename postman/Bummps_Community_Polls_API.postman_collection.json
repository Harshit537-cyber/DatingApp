            "url": {
              "raw": "{{baseUrl}}/api/circle/polls?category=DATING%20VIBE",
              "host": ["{{baseUrl}}"],
              "path": ["api", "circle", "polls"],
              "query": [
                {
                  "key": "category",
                  "value": "DATING VIBE"
                }
              ]
            }
          }
