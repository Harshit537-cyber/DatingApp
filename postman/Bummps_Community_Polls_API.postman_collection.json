    {
      "name": "3. Poll Details",
      "item": [
        {
          "name": "GET Single Poll Details by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Returns complete poll object with percentages', function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data._id).to.eql(pm.collectionVariables.get('pollId'));",
                  "    pm.expect(jsonData.data.options[0]).to.have.property('percentage');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/circle/polls/{{pollId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "circle", "polls", "{{pollId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Voting",
      "item": [
        {
          "name": "POST Cast Vote on Option 0",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Vote recorded and updated percentages returned', function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.hasVoted).to.be.true;",
                  "    pm.expect(jsonData.data.userSelectedOptionIndex).to.eql(0);",
                  "    pm.expect(jsonData.data.totalVotes).to.be.at.least(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"optionIndex\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/circle/polls/{{pollId}}/vote",
              "host": ["{{baseUrl}}"],
              "path": ["api", "circle", "polls", "{{pollId}}", "vote"]
            }
          }
        },
        {
          "name": "POST Cast Vote - Duplicate Vote Prevention (Expect 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 409 Conflict', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test('Rejected with duplicate vote message', function () {",
                  "    pm.expect(jsonData.success).to.be.false;",
                  "    pm.expect(jsonData.message).to.match(/already voted/i);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"optionIndex\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/circle/polls/{{pollId}}/vote",
              "host": ["{{baseUrl}}"],
              "path": ["api", "circle", "polls", "{{pollId}}", "vote"]
            }
